LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
# รหัสผ่านเข้าหน้า /admin (ตั้งให้ยาวและเดายาก)
ADMIN_PASSWORD=
# ที่เก็บข้อมูลถาวร: ตั้งเป็น path ที่ mount Railway Volume เช่น /data
DATA_DIR=/data

# --- เลือก LLM อย่างใดอย่างหนึ่ง ---
# (A) API แบบ OpenAI-compatible (ถ้าตั้งสองตัวนี้ จะใช้ตัวนี้ก่อน Gemini)
LLM_BASE_URL=https://ai.thirx.com/v1
LLM_API_KEY=
LLM_MODEL=qwen3.8-27b
# (B) Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
