LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
# รหัสผ่านเข้าหน้า /admin (อย่างน้อย 8 ตัวอักษร ตั้งให้เดายาก)
ADMIN_PASSWORD=
# ที่เก็บข้อมูลถาวร: ปกติไม่ต้องตั้ง ถ้าแนบ Railway Volume ระบบใช้ path ของ Volume ให้อัตโนมัติ
# DATA_DIR=/data

# --- เลือก LLM อย่างใดอย่างหนึ่ง ---
# (A) API แบบ OpenAI-compatible (ถ้าตั้งสองตัวนี้ จะใช้ตัวนี้ก่อน Gemini)
LLM_BASE_URL=https://ai.thirx.com/v1
LLM_API_KEY=
LLM_MODEL=qwen3.8-27b
# (B) Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
